event: sources
data: {"sources": [{"chunk_id": 25, "question": "退货政策是什么", "answer": "支持 7 天无理由退货,商品需保持完好、不影响二次销售,具体以平台售后规则为准。", "text": "分类：商品与购物 FAQ\n问题：退货政策是什么\n答案：支持 7 天无理由退货,商品需保持完好、不影响二次销售,具体以平台售后规则为准。", "category": "商品与购物 FAQ", "source_ref": "upload:product-faq.md", "section_path": "商品与购物 FAQ / 退货政策是什么", "content_hash": "855557c870013e3f266fa6bf0fe70f494a7e44ece04dcb30d1689919b084dc0c", "score": 0.9845671653747559, "source_url": "/knowledge/chunks/25", "citation": 1}, {"chunk_id": 1, "question": "退货政策是什么", "answer": "签收后7天内，商品完好且不影响二次销售可申请无理由退货。质量问题请联系人工核实。", "text": "分类：售后\n问题：退货政策是什么\n答案：签收后7天内，商品完好且不影响二次销售可申请无理由退货。质量问题请联系人工核实。", "category": "售后", "source_ref": "faq:1", "section_path": "退货政策是什么", "content_hash": "3c482d4ee582b2e6aa3cb12f6b6d899c5522680080ec2bfd9d7b0247991cb02c", "score": 0.9789130091667175, "source_url": "/knowledge/chunks/1", "citation": 2}, {"chunk_id": 4, "question": "退货政策", "answer": "签收后7天内，商品完好且不影响二次销售可申请无理由退货。质量问题请联系人工核实。", "text": "分类：售后手册（演示）\n问题：退货政策\n答案：签收后7天内，商品完好且不影响二次销售可申请无理由退货。质量问题请联系人工核实。", "category": "售后手册（演示）", "source_ref": "markdown:08140701a142:after-sales.md", "section_path": "售后手册（演示） / 退货政策", "content_hash": "c51e78ecf4d297b538fc3713cb483821681349764b3d36fc58f07ce1f7ec0c2d", "score": 0.9400749802589417, "source_url": "/knowledge/chunks/4", "citation": 3}, {"chunk_id": 60, "question": "预售与定金", "answer": "预售商品以详情页标注的时间发货;定金支付后不支持无理由退定金,尾款未按时支付的,定金按活动规则处理。", "text": "分类：退货退款政策\n问题：预售与定金\n答案：预售商品以详情页标注的时间发货;定金支付后不支持无理由退定金,尾款未按时支付的,定金按活动规则处理。", "category": "退货退款政策", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 预售与定金", "content_hash": "d225edf1e32f6c87ecc8cb5b9bd81462e88259f2c2741a44a163420902412180", "score": 0.7798308730125427, "source_url": "/knowledge/chunks/60", "citation": 4}, {"chunk_id": 57, "question": "质量问题与保修", "answer": "电子类商品自签收起保修 12 个月,保修期内非人为损坏可申请免费维修或换货;人为损坏、超保商品维修可能收取工本费。", "text": "分类：退货退款政策\n问题：质量问题与保修\n答案：电子类商品自签收起保修 12 个月,保修期内非人为损坏可申请免费维修或换货;人为损坏、超保商品维修可能收取工本费。", "category": "退货退款政策", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 质量问题与保修", "content_hash": "2498fc08d1e10ec83ca5e23fa296b04f7264d161d77998bf417a04b2217d3b7f", "score": 0.6761593222618103, "source_url": "/knowledge/chunks/57", "citation": 5}, {"chunk_id": 58, "question": "运输破损处理", "answer": "商品运输途中破损的,请在签收后 48 小时内联系客服并提供开箱视频与照片,核实后可免费补发或退款,相关运费由平台承担。", "text": "分类：退货退款政策\n问题：运输破损处理\n答案：商品运输途中破损的,请在签收后 48 小时内联系客服并提供开箱视频与照片,核实后可免费补发或退款,相关运费由平台承担。", "category": "退货退款政策", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 运输破损处理", "content_hash": "dbd71a64e33c164cdf069f7ae5b0d1d574a3e158cdb7f01dcf1c50b496010d89", "score": 0.5856170654296875, "source_url": "/knowledge/chunks/58", "citation": 6}, {"chunk_id": 53, "question": "退款时效", "answer": "退货商品经平台核验通过后,退款原路退回,到账时效以平台售后规则为准。", "text": "分类：退货退款政策 / 无理由退货\n问题：退款时效\n答案：退货商品经平台核验通过后,退款原路退回,到账时效以平台售后规则为准。", "category": "退货退款政策 / 无理由退货", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 无理由退货 / 退款时效", "content_hash": "41abdf6a045d365bf691498776a49f7226ba1e033b77f66f854df38b0cd4f5a8", "score": 0.5249756574630737, "source_url": "/knowledge/chunks/53", "citation": 7}, {"chunk_id": 54, "question": "换货条件", "answer": "收到商品 7 天内,商品完好且配件齐全的,可申请一次同款换货;不同型号或颜色需先退货再重新下单。", "text": "分类：退货退款政策 / 换货政策\n问题：换货条件\n答案：收到商品 7 天内,商品完好且配件齐全的,可申请一次同款换货;不同型号或颜色需先退货再重新下单。", "category": "退货退款政策 / 换货政策", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 换货政策 / 换货条件", "content_hash": "deada413dcf19938b88ef79fa3126ae25fd21e7caa3d44430b5226d156c87d0a", "score": 0.5032595992088318, "source_url": "/knowledge/chunks/54", "citation": 8}, {"chunk_id": 52, "question": "适用范围", "answer": "自签收之日起 7 天内,商品完好、不影响二次销售的,支持无理由退货。定制类、生鲜类商品除外。", "text": "分类：退货退款政策 / 无理由退货\n问题：适用范围\n答案：自签收之日起 7 天内,商品完好、不影响二次销售的,支持无理由退货。定制类、生鲜类商品除外。", "category": "退货退款政策 / 无理由退货", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 无理由退货 / 适用范围", "content_hash": "7397a2fdfbb7ae723ce2eea7436b8709e40260322b08522889e771c1e5956558", "score": 0.48124033212661743, "source_url": "/knowledge/chunks/52", "citation": 9}, {"chunk_id": 55, "question": "换货运费", "answer": "非质量问题的换货,往返运费由买家承担;因质量问题或发错货的换货,往返运费由平台承担。", "text": "分类：退货退款政策 / 换货政策\n问题：换货运费\n答案：非质量问题的换货,往返运费由买家承担;因质量问题或发错货的换货,往返运费由平台承担。", "category": "退货退款政策 / 换货政策", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 换货政策 / 换货运费", "content_hash": "bb549c4ab2c1bfe81d622e131120907467c8083f18f949d00dec986f4f6d190c", "score": 0.42058616876602173, "source_url": "/knowledge/chunks/55", "citation": 10}]}

