event: sources
data: {"sources": [{"chunk_id": 4, "question": "退货政策", "answer": "签收后7天内，商品完好且不影响二次销售可申请无理由退货。质量问题请联系人工核实。", "text": "分类：售后手册（演示）\n问题：退货政策\n答案：签收后7天内，商品完好且不影响二次销售可申请无理由退货。质量问题请联系人工核实。", "category": "售后手册（演示）", "source_ref": "markdown:08140701a142:after-sales.md", "section_path": "售后手册（演示） / 退货政策", "content_hash": "c51e78ecf4d297b538fc3713cb483821681349764b3d36fc58f07ce1f7ec0c2d", "content_type": "policy", "score": 0.45232149958610535, "source_url": "/knowledge/chunks/4", "citation": 1}, {"chunk_id": 25, "question": "退货政策是什么", "answer": "支持 7 天无理由退货,商品需保持完好、不影响二次销售,具体以平台售后规则为准。", "text": "分类：商品与购物 FAQ\n问题：退货政策是什么\n答案：支持 7 天无理由退货,商品需保持完好、不影响二次销售,具体以平台售后规则为准。", "category": "商品与购物 FAQ", "source_ref": "upload:product-faq.md", "section_path": "商品与购物 FAQ / 退货政策是什么", "content_hash": "855557c870013e3f266fa6bf0fe70f494a7e44ece04dcb30d1689919b084dc0c", "content_type": "policy", "score": 0.3360362648963928, "source_url": "/knowledge/chunks/25", "citation": 2}, {"chunk_id": 52, "question": "适用范围", "answer": "自签收之日起 7 天内,商品完好、不影响二次销售的,支持无理由退货。定制类、生鲜类商品除外。", "text": "分类：退货退款政策 / 无理由退货\n问题：适用范围\n答案：自签收之日起 7 天内,商品完好、不影响二次销售的,支持无理由退货。定制类、生鲜类商品除外。", "category": "退货退款政策 / 无理由退货", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 无理由退货 / 适用范围", "content_hash": "7397a2fdfbb7ae723ce2eea7436b8709e40260322b08522889e771c1e5956558", "content_type": "policy", "score": 0.32812511920928955, "source_url": "/knowledge/chunks/52", "citation": 3}, {"chunk_id": 59, "question": "不支持退货的商品", "answer": "定制类、生鲜类、已拆封的猫砂等消耗品,以及标注「不支持无理由退货」的商品,非质量问题不支持退货。", "text": "分类：退货退款政策\n问题：不支持退货的商品\n答案：定制类、生鲜类、已拆封的猫砂等消耗品,以及标注「不支持无理由退货」的商品,非质量问题不支持退货。", "category": "退货退款政策", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 不支持退货的商品", "content_hash": "9c1242500a3243928d89d603d6a3767c6363484334e1fbe6b0dcba364ff877c0", "content_type": "policy", "score": 0.27143537998199463, "source_url": "/knowledge/chunks/59", "citation": 4}, {"chunk_id": 11, "question": "BX-500 容量与清洗", "answer": "BX-500 便携水杯的标称容量为500毫升。BX-500 不适合放入洗碗机，请使用温水手洗。清洗前应拆下杯盖。", "text": "分类：型号手册（演示）\n问题：BX-500 容量与清洗\n答案：BX-500 便携水杯的标称容量为500毫升。BX-500 不适合放入洗碗机，请使用温水手洗。清洗前应拆下杯盖。", "category": "型号手册（演示）", "source_ref": "markdown:08140701a142:models.md", "section_path": "型号手册（演示） / BX-500 容量与清洗", "content_hash": "bd4baa00343d97ac37ea049870ac4e61339fa3c5e996ed1bc8ef4a10a31da366", "content_type": "policy", "score": 0.2195177674293518, "source_url": "/knowledge/chunks/11", "citation": 5}, {"chunk_id": 54, "question": "换货条件", "answer": "收到商品 7 天内,商品完好且配件齐全的,可申请一次同款换货;不同型号或颜色需先退货再重新下单。", "text": "分类：退货退款政策 / 换货政策\n问题：换货条件\n答案：收到商品 7 天内,商品完好且配件齐全的,可申请一次同款换货;不同型号或颜色需先退货再重新下单。", "category": "退货退款政策 / 换货政策", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 换货政策 / 换货条件", "content_hash": "deada413dcf19938b88ef79fa3126ae25fd21e7caa3d44430b5226d156c87d0a", "content_type": "policy", "score": 0.1854650229215622, "source_url": "/knowledge/chunks/54", "citation": 6}, {"chunk_id": 57, "question": "质量问题与保修", "answer": "电子类商品自签收起保修 12 个月,保修期内非人为损坏可申请免费维修或换货;人为损坏、超保商品维修可能收取工本费。", "text": "分类：退货退款政策\n问题：质量问题与保修\n答案：电子类商品自签收起保修 12 个月,保修期内非人为损坏可申请免费维修或换货;人为损坏、超保商品维修可能收取工本费。", "category": "退货退款政策", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 质量问题与保修", "content_hash": "2498fc08d1e10ec83ca5e23fa296b04f7264d161d77998bf417a04b2217d3b7f", "content_type": "policy", "score": 0.1655445694923401, "source_url": "/knowledge/chunks/57", "citation": 7}, {"chunk_id": 56, "question": "退换货运费承担", "answer": "无理由退货的退回运费由买家承担;因商品质量问题、发错货、少发漏发导致的退换货,运费由平台承担。运费承担以平台售后规则最终判定为准。", "text": "分类：退货退款政策\n问题：退换货运费承担\n答案：无理由退货的退回运费由买家承担;因商品质量问题、发错货、少发漏发导致的退换货,运费由平台承担。运费承担以平台售后规则最终判定为准。", "category": "退货退款政策", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 退换货运费承担", "content_hash": "6f1515d26257e3d24932058a5cb38e5dc88e4b9c20a0d9a0e19ae7b759e9baa6", "content_type": "policy", "score": 0.0910266563296318, "source_url": "/knowledge/chunks/56", "citation": 8}, {"chunk_id": 53, "question": "退款时效", "answer": "退货商品经平台核验通过后,退款原路退回,到账时效以平台售后规则为准。", "text": "分类：退货退款政策 / 无理由退货\n问题：退款时效\n答案：退货商品经平台核验通过后,退款原路退回,到账时效以平台售后规则为准。", "category": "退货退款政策 / 无理由退货", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 无理由退货 / 退款时效", "content_hash": "41abdf6a045d365bf691498776a49f7226ba1e033b77f66f854df38b0cd4f5a8", "content_type": "policy", "score": 0.08959922939538956, "source_url": "/knowledge/chunks/53", "citation": 9}, {"chunk_id": 58, "question": "运输破损处理", "answer": "商品运输途中破损的,请在签收后 48 小时内联系客服并提供开箱视频与照片,核实后可免费补发或退款,相关运费由平台承担。", "text": "分类：退货退款政策\n问题：运输破损处理\n答案：商品运输途中破损的,请在签收后 48 小时内联系客服并提供开箱视频与照片,核实后可免费补发或退款,相关运费由平台承担。", "category": "退货退款政策", "source_ref": "upload:returns-policy.md", "section_path": "退货退款政策 / 运输破损处理", "content_hash": "dbd71a64e33c164cdf069f7ae5b0d1d574a3e158cdb7f01dcf1c50b496010d89", "content_type": "policy", "score": 0.08239833265542984, "source_url": "/knowledge/chunks/58", "citation": 10}]}

