# 必填：上游必须提供 OpenAI Chat Completions 兼容接口。
# 填写 API 根地址（通常以 /v1 结尾），不要填写 /chat/completions。
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_MODEL=replace-with-model-name
OPENAI_API_KEY=replace-with-api-key

# 本章仅使用这两种方式；不支持时明确报错，不会自动改用工具调用。
# DeepSeek 的 Chat Completions 接口使用 json_mode（response_format=json_object）。
STRUCTURED_OUTPUT_METHOD=json_schema

# 上游要求旧版 max_tokens 时，显式改为 max_tokens；不自动探测或重试。
OUTPUT_TOKEN_PARAMETER=max_completion_tokens

CONTEXT_WINDOW_TOKENS=8192
MAX_OUTPUT_TOKENS=1024
TOKEN_SAFETY_MARGIN=256
MODEL_TIMEOUT_SECONDS=60

# 先运行 scripts/setup_mysql.py 复用现有 Docker MySQL，或按 README 使用 compose。
# 以下账号仅用于本地演示，生产环境应自行配置凭据。
# 必填：通过系统环境变量或 .env 配置；代码不提供默认数据库连接地址。
DATABASE_URL=mysql+aiomysql://support_agent_ch02:support_agent_demo@127.0.0.1:3306/support_agent_ch02?charset=utf8mb4
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=1
