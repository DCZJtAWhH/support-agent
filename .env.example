# 必填：上游必须提供 OpenAI Chat Completions 兼容接口。
# 填写 API 根地址（通常以 /v1 结尾），不要填写 /chat/completions。
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_MODEL=replace-with-model-name
OPENAI_API_KEY=replace-with-api-key
# auto 仅自动识别官方 DeepSeek 域名；其他 OpenAI 兼容地址使用 openai。
# 通过网关调用 DeepSeek 且需要其专用协议时显式填 deepseek。
MODEL_PROVIDER=auto
# 真实测试统一使用此累计1元账本；正常业务部署可不设置该测试选项。
# MODEL_TEST_BUDGET_PATH=data/real-budget.sqlite

# 仅支持以下两种方式；不支持时明确报错，不会自动改用工具调用。
# DeepSeek 的 Chat Completions 接口使用 json_mode（response_format=json_object）。
STRUCTURED_OUTPUT_METHOD=json_schema

# 上游要求旧版 max_tokens 时，显式改为 max_tokens；不自动探测或重试。
OUTPUT_TOKEN_PARAMETER=max_completion_tokens

MODEL_CONTEXT_WINDOW=128000
MAX_OUTPUT_TOKENS=1024
TOKEN_SAFETY_MARGIN=250
MODEL_TIMEOUT_SECONDS=60

# 按 README 使用 compose；复用现有 MySQL 时先配置项目库及账号。
# 以下账号仅用于本地演示，生产环境应自行配置凭据。
# 必填：通过系统环境变量或 .env 配置；代码不提供默认数据库连接地址。
DATABASE_URL=mysql+aiomysql://support_agent:support_agent@127.0.0.1:3306/support_agent?charset=utf8mb4
TOOL_TIMEOUT_SECONDS=30
TOOL_MAX_RETRIES=1

# 两个 MCP Server 单独启动。JSON 由 Settings 读取，每轮重新发现工具。
MCP_SERVERS={"logistics":{"transport":"streamable_http","url":"http://127.0.0.1:8101/mcp"},"aftersales":{"transport":"streamable_http","url":"http://127.0.0.1:8102/mcp"}}
# 本地精确授权，文件热读取；Server 描述与 annotations 不参与权限判断。
MCP_POLICY_PATH=config/tool-permissions.json

# 硅基流动固定 BAAI/bge-m3 dense 嵌入，密钥仅放本地 .env。
SILICONFLOW_API_KEY=replace-with-siliconflow-api-key
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge
KNOWLEDGE_TOP_K=3
KNOWLEDGE_MIN_SCORE=0.4

# 独立混合集合；保留旧 dense 集合，首次切换需 sync --rebuild。
MILVUS_HYBRID_COLLECTION=knowledge_hybrid_v1
# 只作用于 bge-reranker-v2-m3 相关分；不将 RRF 分当成概率。
RERANK_MIN_SCORE=0.05

# LangGraph 内置 SQLite checkpointer，按单工作进程部署。
CHECKPOINT_PATH=data/checkpoints.sqlite
MAX_AGENT_STEPS=6
AGENT_TOKEN_BUDGET=1000000

# 分流默认使用现有 DeepSeek 上游的高能力模型，不启用小模型降级。
# 其他 OpenAI 兼容上游请明确设置为其支持的高能力模型名。
ROUTER_MODEL=deepseek-v4-pro
INTENT_MIN_CONFIDENCE=0.65

# 预算与中文折算共同校准；工具额度为每步全部观察结果的合计。
MAX_USER_INPUT_TOKENS=2000
TOOL_RESULT_MAX_TOKENS=1200
RERANK_TOP_K=5
TOKEN_CHARS_PER_TOKEN=2.0
SYSTEM_TOOLS_TOKENS=1000
EVIDENCE_TOKENS_PER_RESULT=100
SUMMARY_INJECTION_TOKENS=200
HISTORY_TARGET_ROUNDS=40
STEADY_ROUND_TOKENS=1000
LAYER2_ASSISTANT_CHARS=60

# 复用自托管 Langfuse，必须填写本地项目的 API Keys；不连接云端默认地址。
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 问题池默认每10秒整理；设为0关闭自动处理，仍可在审核页手动触发。
FLYWHEEL_INTERVAL_SECONDS=10
# 完整检索与生成评估默认每天运行；设为0只保留手动运行。
EVAL_INTERVAL_SECONDS=86400
# 逐事实评委输出比聊天长，独立预留输出额度，不改变聊天输出预算。
EVAL_MAX_OUTPUT_TOKENS=4096
# 校准产物由 scripts/calibrate_evidence.py 从真实检索与生成评估报告生成。
# EVIDENCE_CALIBRATION_PATH=config/evidence-confidence.json
# DeepSeek 默认开启思考；小输出预算下推荐显式关闭，README 的启动命令会设置 disabled。
# MODEL_THINKING=disabled
